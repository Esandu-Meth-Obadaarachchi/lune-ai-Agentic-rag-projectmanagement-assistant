rules_version = '2';

// Second Brain — per-workspace isolation. Every doc carries `memberIds`; a user
// can only touch a document if their uid is in that list. This keeps businesses
// (Office / Freelance / LeadX) fully separated with no cross-workspace bleed.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(data) {
      return signedIn() && request.auth.uid in data.memberIds;
    }

    match /workspaces/{id} {
      allow read: if isMember(resource.data);
      allow create: if isMember(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMember(resource.data) && isMember(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /projects/{id} {
      allow read: if isMember(resource.data);
      allow create: if isMember(request.resource.data);
      allow update, delete: if isMember(resource.data);
    }

    match /tasks/{id} {
      allow read: if isMember(resource.data);
      allow create: if isMember(request.resource.data);
      allow update, delete: if isMember(resource.data);
    }

    // Sprints. memberIds mirrors the sprint's project, so a project-scoped
    // teammate sees their project's sprints and nobody else's.
    match /sprints/{id} {
      allow read: if isMember(resource.data);
      allow create: if isMember(request.resource.data);
      allow update, delete: if isMember(resource.data);
    }

    // Task timeline: comments and system events. memberIds mirrors the task's
    // project, so the thread is visible to exactly the people who can see the
    // task. A comment may only be edited or deleted by its author; events are
    // never mutated after the fact.
    match /timeline/{id} {
      allow read: if isMember(resource.data);
      allow create: if isMember(request.resource.data)
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isMember(resource.data)
        && resource.data.uid == request.auth.uid
        && resource.data.kind == "comment";
    }

    // Personal notifications. memberIds is always the single recipient, but the
    // recipient must not be able to forge one for themselves from another
    // actor, so creates are gated on membership of the task's audience instead:
    // anyone who can see the task can notify someone else who can. Only the
    // recipient reads or updates (marking read).
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.memberIds.hasOnly([request.resource.data.uid]);
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Live presence on a task. A user may only write their own presence doc
    // (doc id is `${taskId}_${uid}`), and only within a workspace they belong to.
    match /presence/{id} {
      allow read: if isMember(resource.data);
      allow create, update: if isMember(request.resource.data)
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Per-user daily planner notes. memberIds is always the single owner uid.
    // A not-yet-created doc has a null `resource`, so allow signed-in reads of
    // the empty state (there is nothing to leak) and gate everything else on
    // membership. Ordering matters: the null check short-circuits before
    // isMember touches resource.data.
    match /dayPlans/{id} {
      allow read: if (resource == null && signedIn()) || isMember(resource.data);
      allow create: if isMember(request.resource.data);
      allow update, delete: if isMember(resource.data);
    }

    // Per-project whiteboard scenes. memberIds mirrors the project's members.
    // Same null-resource handling so a project with no saved scene can load an
    // empty canvas instead of hanging on a permission error.
    match /whiteboards/{id} {
      allow read: if (resource == null && signedIn()) || isMember(resource.data);
      allow create: if isMember(request.resource.data);
      allow update, delete: if isMember(resource.data);
    }

    // Notion-style pages. memberIds mirrors the workspace or the page's project.
    match /pages/{id} {
      allow read: if (resource == null && signedIn()) || isMember(resource.data);
      allow create: if isMember(request.resource.data);
      allow update, delete: if isMember(resource.data);
    }

    // Saved agent conversations, personal to one user (memberIds = [uid]).
    match /chats/{id} {
      allow read: if isMember(resource.data);
      allow create: if isMember(request.resource.data);
      allow update, delete: if isMember(resource.data);
    }

    // Individual turns within a chat. Same per-user isolation as the chat.
    match /chatMessages/{id} {
      allow read: if isMember(resource.data);
      allow create: if isMember(request.resource.data);
      allow update, delete: if isMember(resource.data);
    }

    // Share invitations are managed entirely server-side by the Admin SDK
    // (which bypasses rules), so clients get no direct access.
    match /invites/{id} {
      allow read, write: if false;
    }

    // Per-user Claude usage totals, written by the Admin SDK (lib/ai/usage.ts) and
    // read only by the admin dashboard route. Never touched from the client.
    match /usage/{id} {
      allow read, write: if false;
    }

    // ---- RAG / agent server-side collections -------------------------------
    // All four are written and read exclusively by the Admin SDK from
    // `src/lib/ai/**`, which bypasses rules. Closing them to clients is the
    // point rather than an omission, and each has a specific reason.

    // Held plans awaiting the user's approval. A proposal id is a capability to
    // write tasks, so ownership is checked in code on every load (lib/ai/
    // proposals.ts) and the client reaches it only through /api/proposals/[id].
    // Direct client access would let anyone with an id approve someone's plan.
    match /agentProposals/{id} {
      allow read, write: if false;
    }

    // Format examples the user has given the agent to match. Server-only so a
    // client cannot plant text that later becomes part of a prompt.
    match /agentExamples/{id} {
      allow read, write: if false;
    }

    // The write audit log: who changed what, when. Append-only from the server
    // and never client-writable, or the record could be edited by the party it
    // exists to hold accountable.
    match /agentAudit/{id} {
      allow read, write: if false;
    }

    // The durable cache tier (answers, embeddings, chunk vectors, rate-limit
    // counters) when no Redis is configured. Entries are keyed by user and by
    // project scope, so client read access would leak other users' answers, and
    // client writes would let a caller reset their own rate-limit counter.
    match /agentCache/{id} {
      allow read, write: if false;
    }
  }
}
