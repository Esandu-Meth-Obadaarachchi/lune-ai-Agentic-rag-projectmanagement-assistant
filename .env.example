# ============================================================================
# Second Brain — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================================

# ---- Firebase (client SDK) — safe to expose, these are public identifiers ----
# Firebase console -> Project settings -> General -> Your apps -> SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (server) — SECRET. Service account from Firebase console ----
# Project settings -> Service accounts -> Generate new private key.
# Paste the values from that JSON here. The private key must keep its \n escapes,
# so wrap the whole value in double quotes exactly as shown.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Claude (Anthropic) — SECRET. The agent + RAG generation model ----
ANTHROPIC_API_KEY=
# Generation model for the agent + RAG answers. Default: claude-haiku-4-5 (cheapest).
CLAUDE_MODEL=claude-haiku-4-5
# The cheap model for retrieval helpers: rewrite, grade, groundedness, summaries.
CLAUDE_FAST_MODEL=claude-haiku-4-5
# The escalation tier for planning and judgement turns (adaptive thinking).
# Set DEEP_MODEL_ENABLED=false to keep every turn on the cheap tier.
CLAUDE_DEEP_MODEL=claude-sonnet-5-5
DEEP_MODEL_ENABLED=true
CLAUDE_DEEP_EFFORT=medium
# Reasoning budget on the middle tier. Haiku 4.5 takes an explicit budget.
THINKING_BUDGET_TOKENS=2048
ANSWER_MAX_TOKENS=1500
EXPOSE_REASONING=true
GROUNDEDNESS_CHECK_ENABLED=true

# ---- Voyage AI — SECRET. Document + query embeddings + reranking ----
# https://dash.voyageai.com/  (embed: voyage-3.5 1024-dim; rerank: rerank-2.5)
VOYAGE_API_KEY=
# Cross-encoder reranker used by the agentic retrieval loop (see docs/AGENTIC_RAG.md).
VOYAGE_RERANK_MODEL=rerank-2.5

# ---- Pinecone — SECRET. Vector store for the RAG knowledge base ----
# Create a NEW index for Voyage embeddings: dimension 1024, metric cosine.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=second-brain

# ---- LangSmith — optional. Traces every model call in the agent + retrieval ----
# https://smith.langchain.com/   Leave LANGSMITH_TRACING=false to disable.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=second-brain-rag

# ---- Google Calendar sync — SECRET (OAuth 2.0 Web client) ----
# Google Cloud console -> APIs & Services -> Credentials -> Create OAuth client
# (Web). Enable the Google Calendar API. Add the redirect URI below. See
# docs/CALENDAR.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/calendar/callback
# Base URL used to build the OAuth return redirect (usually your app origin).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public HTTPS endpoint Google pushes calendar changes to (live reverse sync).
# Leave blank for one-way + manual "Sync now". For live sync locally, run a
# tunnel (cloudflared/ngrok) and set: https://<tunnel>/api/calendar/webhook
CALENDAR_WEBHOOK_URL=

# ============================================================================
# RAG pipeline (all optional — every value below is a sensible default)
# Full explanations: docs/RAG.md, docs/AGENTIC_RAG.md, docs/SECURITY.md
# ============================================================================

# ---- Chunking: token budgets, not character windows ----
CHUNK_TARGET_TOKENS=480
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_TOKENS=80

# ---- Contextual retrieval: one generated sentence per chunk, at ingest ----
# The document rides in a cached prompt prefix, so this costs cents per file.
# Turning it off saves ingest cost and loses recall.
CONTEXTUAL_RETRIEVAL_ENABLED=true
CONTEXT_MODEL=claude-haiku-4-5
CONTEXT_CONCURRENCY=8
CONTEXT_MAX_DOCUMENT_CHARS=180000
CONTEXT_MAX_CHUNKS=300

# ---- Vision: OCR for scanned PDF pages, captions for images (ingest only) ----
# Pages go to Claude as a PDF document block — no rasterising, several per call.
# VISION_MAX_CALLS_PER_DOC is the hard ceiling that stops a 300-page scan
# becoming a four-figure surprise.
VISION_ENABLED=true
VISION_MODEL=claude-haiku-4-5
VISION_MAX_CALLS_PER_DOC=20
VISION_PAGES_PER_CALL=4
VISION_CONCURRENCY=4

# ---- Hybrid search: dense + learned lexical ----
# OFF by default. Hybrid records need a *dotproduct* Pinecone index, and the
# live index is cosine — a property that cannot be changed in place. Leave this
# false and everything runs dense-only, exactly as before. To enable: create a
# dotproduct index, repoint PINECONE_INDEX_NAME, set this true, re-ingest.
HYBRID_SEARCH_ENABLED=false
PINECONE_SPARSE_MODEL=pinecone-sparse-english-v0

# ---- Retrieval confidence gate ----
# Above the first, the reranker is sure enough that an LLM grade adds latency
# and nothing else. Below the second it is plainly weak. Only the band between
# is worth a model call.
RERANK_CONFIDENT_SCORE=0.50
RERANK_WEAK_SCORE=0.22

# ---- Cache ----
# Upstash REST is the right shape for serverless: one HTTPS call per operation,
# no connection to keep alive. Leave both blank and the durable tier falls back
# to Firestore, and failing that to in-process only (per-instance, lost on
# redeploy). GET /api/ready reports which tier is actually live.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_FIRESTORE_FALLBACK=true
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=1800
SEMANTIC_CACHE_ENABLED=true
# Deliberately high: "what is due today" and "what was due today" sit around
# 0.94 apart and mean different things, so a near miss must be a miss.
SEMANTIC_CACHE_THRESHOLD=0.965

# ---- Conversation memory ----
MEMORY_RECENT_PAIRS=3

# ---- Guardrails (see docs/SECURITY.md) ----
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_INGEST_PER_HOUR=60
REDACT_SECRETS_IN_ANSWERS=true
# Above this many tasks in one request the agent proposes instead of writing.
# 0 disables the approval gate entirely.
APPROVAL_TASK_THRESHOLD=5
PROPOSAL_TTL_SECONDS=3600
